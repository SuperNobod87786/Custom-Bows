    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "rootDir": "./scripts",
        "outDir": "./BP/scripts"
    },
    "exclude": [
        "node_modules"
    ]
}